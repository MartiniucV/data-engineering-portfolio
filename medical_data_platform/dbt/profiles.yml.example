medinsight:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DB_HOST', 'localhost') }}"
      port: 5432
      user: "{{ env_var('DB_USER', 'vlad') }}"
      password: "{{ env_var('DB_PASSWORD', 'vlad123') }}"
      dbname: "{{ env_var('DB_NAME', 'portfolio') }}"
      schema: staging
      threads: 4
      keepalives_idle: 0
      connect_timeout: 10

    prod:
      type: postgres
      host: "{{ env_var('PROD_DB_HOST') }}"
      port: 5432
      user: "{{ env_var('PROD_DB_USER') }}"
      password: "{{ env_var('PROD_DB_PASSWORD') }}"
      dbname: "{{ env_var('PROD_DB_NAME') }}"
      schema: analytics
      threads: 8
